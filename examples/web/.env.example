# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Configuration
# Read by /api/realtime (Gemini Live, the realtime default), /api/chat-gemini,
# /api/tts-gemini, and /api/stt-gemini. Without it, realtime voice can be
# switched to OpenAI Realtime in the settings menu, and the Gemini Remote chat,
# TTS, and STT options fail until the key is set — all three Gemini Direct
# (Dev) options prompt for their own key in the browser instead.
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenClaw Token
# Get your token from gateway.auth.token
OPENCLAW_TOKEN=your_openclaw_token_here
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_AGENT_ID=main
