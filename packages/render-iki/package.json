{
  "name": "@charivo/render-iki",
  "version": "0.3.1",
  "description": "Iki 2D puppet renderer for Charivo AI characters",
  "type": "module",
  "main": "dist/renderer.js",
  "module": "dist/renderer.js",
  "types": "dist/src/renderer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/renderer.d.ts",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json --emitDeclarationOnly --declarationDir dist --pretty false",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "charivo",
    "iki",
    "avatar",
    "webgl",
    "lipsync"
  ],
  "dependencies": {
    "@charivo/core": "workspace:^",
    "@charivo/render": "workspace:^",
    "@ikijs/engine": "^0.13.0",
    "@ikijs/format": "^0.12.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeikar/charivo.git",
    "directory": "packages/render-iki"
  },
  "author": {
    "name": "Zeikar",
    "url": "https://github.com/zeikar"
  },
  "homepage": "https://github.com/zeikar/charivo#readme",
  "bugs": {
    "url": "https://github.com/zeikar/charivo/issues"
  }
}
