{
  "name": "@charivo/render-live2d",
  "version": "0.5.4",
  "description": "Live2D rendering engine for Charivo",
  "type": "module",
  "main": "dist/renderer.js",
  "module": "dist/renderer.js",
  "types": "dist/src/renderer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/renderer.d.ts",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE.md",
    "CubismSdkForWeb-5-r.4/LICENSE.md",
    "CubismSdkForWeb-5-r.4/NOTICE.md",
    "CubismSdkForWeb-5-r.4/Core/LICENSE.md",
    "CubismSdkForWeb-5-r.4/Core/RedistributableFiles.txt",
    "CubismSdkForWeb-5-r.4/Framework/LICENSE.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json --emitDeclarationOnly --declarationDir dist --pretty false",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "charivo",
    "live2d",
    "cubism",
    "webgl",
    "lipsync"
  ],
  "dependencies": {
    "@charivo/core": "workspace:^",
    "@charivo/render": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeikar/charivo.git",
    "directory": "packages/render-live2d"
  },
  "author": {
    "name": "Zeikar",
    "url": "https://github.com/zeikar"
  },
  "homepage": "https://github.com/zeikar/charivo#readme",
  "bugs": {
    "url": "https://github.com/zeikar/charivo/issues"
  }
}
